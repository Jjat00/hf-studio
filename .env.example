# HF Studio configuration. Only HF_API_KEY is required; `uv run hf-studio start` (or ./dev.sh, dev.cmd)
# asks for it on the first run.
# These keys stay on the server: agents and the UI use their own hfs_… keys.

# Required. Higgsfield: https://console.higgsfield.ai -> API keys. Paste it as given (KEY_ID:KEY_SECRET).
# Check it without spending credits: uv run hf-studio check-credentials
HF_API_KEY=
# Alternative if you have it in two parts (ignored when HF_API_KEY is set):
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=

# Optional, only for audio (voice change, text to speech, sound effects, music, voice isolation).
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys. Without it, video and image work as usual.
# If you restrict the key, allow: Text to Speech, Speech to Speech, Sound Effects, Music, Voice Isolator,
# Voices (read and write), History (read) and User (read).
ELEVENLABS_API_KEY=

# Optional, cheaper video providers. HF Studio quotes every provider that has a key and sends each video
# to the cheapest one, falling back to the next if it fails. Higgsfield (above) stays required: inputs
# are uploaded there, which costs no credits.
# APIMart: sign up at https://apimart.ai/register, then create a key at https://apimart.ai/keys
APIMART_API_KEY=
# KIE: sign up at https://kie.ai, then create a key at https://kie.ai/api-key
KIE_API_KEY=

# ---- Everything below is optional; the defaults work. ----

# Storage (SQLite by default; for Postgres use postgresql+asyncpg://… and install asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./data/hf_studio.db
STORAGE_DIR=./data/files

# Public HTTPS URL of this server to receive webhooks (without it, jobs are polled)
PUBLIC_BASE_URL=

# Concurrency of your Higgsfield account (see console.higgsfield.ai) and job limits
HF_MAX_CONCURRENCY=4
MAX_ACTIVE_JOBS_PER_CLIENT=10
JOB_TIMEOUT_SECONDS=1800
DEDUPE_WINDOW_SECONDS=600
DOWNLOAD_OUTPUTS=true
MAX_UPLOAD_BYTES=209715200

# Browser origins allowed to call the API directly, comma-separated. The bundled UI does not need it
# (it goes through its own server-side proxy).
CORS_ORIGINS=
