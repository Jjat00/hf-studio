# Credencial de Higgsfield: https://console.higgsfield.ai → API keys. Solo en el servidor.
# Pega la clave tal como la da la consola (formato KEY_ID:KEY_SECRET) y compruébala sin gastar
# créditos con: uv run hf-studio check-credentials
HF_API_KEY=
# Alternativa si la tienes en dos partes (se ignora si HF_API_KEY tiene valor):
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=

# Persistencia (SQLite por defecto; Postgres: postgresql+asyncpg://… e instalar asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./data/hf_studio.db
STORAGE_DIR=./data/files

# URL HTTPS pública de este servidor para recibir webhooks (opcional; sin ella se usa solo sondeo)
PUBLIC_BASE_URL=

# Concurrencia de tu cuenta en Higgsfield (ver console.higgsfield.ai)
HF_MAX_CONCURRENCY=4
MAX_ACTIVE_JOBS_PER_CLIENT=10
JOB_TIMEOUT_SECONDS=1800
DEDUPE_WINDOW_SECONDS=600
DOWNLOAD_OUTPUTS=true
MAX_UPLOAD_BYTES=209715200

# Orígenes de la futura UI, separados por coma (p. ej. http://localhost:3000)
CORS_ORIGINS=
